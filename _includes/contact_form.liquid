{%- comment -%}
Message form at the bottom of the about page. Submissions go through Web3Forms
(https://web3forms.com), which forwards them to the email tied to the access key.
The key can only send to that email, so it is safe to keep in the page source.
"botcheck" is a hidden honeypot: Web3Forms drops submissions where it is filled.
Output is kept free of blank lines and indentation so kramdown leaves it as raw HTML.
{%- endcomment -%}
<style>
.contact{margin-bottom:2.5rem}
.contact form{max-width:36rem}
.contact .contact-row{display:flex;gap:.75rem;flex-wrap:wrap}
.contact .contact-row > div{flex:1 1 12rem}
.contact label{display:block;font-size:.85rem;color:var(--global-text-color-light);margin:0 0 .2rem}
.contact input,.contact textarea{width:100%;box-sizing:border-box;margin-bottom:.75rem;padding:.45rem .6rem;font:inherit;color:var(--global-text-color);background:var(--global-bg-color);border:1px solid var(--global-divider-color);border-radius:.25rem}
.contact input:focus,.contact textarea:focus{outline:none;border-color:var(--global-theme-color)}
.contact textarea{min-height:8rem;resize:vertical}
.contact button{padding:.4rem 1.2rem;font:inherit;color:#fff;background:var(--global-theme-color);border:none;border-radius:.25rem;cursor:pointer}
.contact button:disabled{opacity:.6;cursor:default}
.contact .contact-status{margin-left:.75rem;font-size:.9rem;color:var(--global-text-color-light)}
</style>
<div class="contact">
<h2>leave me a message</h2>
<form id="contact-form">
<input type="hidden" name="access_key" value="c47c3c0b-d218-4ff1-acad-2d83671f6ef6">
<input type="hidden" name="subject" value="New message from your personal website">
<input type="hidden" name="from_name" value="yuehongchen.github.io">
<input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">
<div class="contact-row">
<div><label for="contact-name">Name</label><input id="contact-name" type="text" name="name" required></div>
<div><label for="contact-email">Email</label><input id="contact-email" type="email" name="email" required></div>
</div>
<label for="contact-message">Message</label>
<textarea id="contact-message" name="message" required></textarea>
<button type="submit">Send</button><span class="contact-status" aria-live="polite"></span>
</form>
</div>
<script>
(function(){
var form=document.getElementById("contact-form");
var button=form.querySelector("button");
var status=form.querySelector(".contact-status");
form.addEventListener("submit",function(e){
e.preventDefault();
button.disabled=true;
status.textContent="Sending…";
fetch("https://api.web3forms.com/submit",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify(Object.fromEntries(new FormData(form)))})
.then(function(r){return r.json();})
.then(function(d){
if(d.success){form.reset();status.textContent="Thanks, your message has been sent.";}
else{status.textContent="Sorry, something went wrong. Please email me instead.";}
})
.catch(function(){status.textContent="Sorry, something went wrong. Please email me instead.";})
.finally(function(){button.disabled=false;});
});
})();
</script>
